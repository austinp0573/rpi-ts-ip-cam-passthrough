# camera bridge configuration

# which network to use: "home" or "deployment"
active_network: "home"

# home network config
home:
  camera_ip: "192.168.1.100"
  camera_username: "admin"
  camera_password: "your_password_here"
  rtsp_main_stream: "/ch0"
  rtsp_sub_stream: "/ch1"
  rtsp_port: 554
  onvif_port: 80
  http_port: 80
  https_port: 0

# deployment network config
deployment:
  camera_ip: "192.168.2.100"
  camera_username: "admin"
  camera_password: "your_password_here"
  rtsp_main_stream: "/ch0"
  rtsp_sub_stream: "/ch1"
  rtsp_port: 554
  onvif_port: 80
  http_port: 80
  https_port: 0

# forwarded ports on the pi (exposed through tailscale)
forwarded_ports:
  rtsp_main: 8554
  rtsp_sub: 8555
  onvif: 8080
  http: 8081
  https: 8443

